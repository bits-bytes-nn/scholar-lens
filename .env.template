# Local runs read these from .env; Batch jobs read the same secrets from SSM
# (write them with `poetry run python scripts/put_secrets.py`).

# Blog pull requests (repo contents + pull requests write on the blog repo).
GITHUB_TOKEN=
# Upstage Document Parse: required for PDF parsing (non-arXiv sources and the
# HTML-to-PDF fallback); PyMuPDF only covers a failed Upstage call.
UPSTAGE_API_KEY=

# Web search for tech-guide research (optional). Guides search with AgentCore
# Web Search on the AWS credentials first (tech_guide.web_search); a query it
# fails goes to Tavily, then Brave, when their keys are set.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Citation lookups (optional): an email for the Crossref and OpenAlex polite
# pools, an OpenAlex key (keyless use allows only ~100 searches per day per IP;
# free key at https://openalex.org/settings/api) and a Semantic Scholar key
# (Semantic Scholar is queried only when one is set).
CROSSREF_MAILTO=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# LangSmith tracing (optional).
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=scholar-lens

LOG_LEVEL=INFO
# AWS profile for deploy/put_secrets when resources.profile_name is not set.
AWS_PROFILE_NAME=

# Not secrets, and set by you (the stack sets the rest of SCHOLAR_LENS_*): set
# them in the shell for one command, not here (a lasting
# SCHOLAR_LENS_ALLOW_DIRTY_DEPLOY would skip the deploy guard every time).
# See docs/usage.md and docs/design.md.
# SCHOLAR_LENS_CONFIG=        another config file than scholar_lens/configs/config.yaml
# SCHOLAR_LENS_ALLOW_DIRTY_DEPLOY=1   deploy uncommitted image sources on dev
# SCHOLAR_LENS_BATCH_TRACING=true     trace Batch jobs to LangSmith
