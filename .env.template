# Local runs read these from .env; Batch jobs read the same secrets from SSM
# (write them with `poetry run python scripts/put_secrets.py`).

# Blog pull requests (repo contents + pull requests write on the blog repo).
GITHUB_TOKEN=
# Upstage Document Parse: required for PDF parsing (non-arXiv sources and the
# HTML-to-PDF fallback); PyMuPDF only covers a failed Upstage call.
UPSTAGE_API_KEY=

# Web search for tech-guide research (optional). Tavily is preferred (returns
# cleaned page content); Brave is the fallback. With neither set, guides use
# only the supplied URLs.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Citation lookups (optional): an email for Crossref's polite pool and a
# Semantic Scholar key raise the rate limits for reference abstracts.
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

# LangSmith tracing (optional).
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=scholar-lens

LOG_LEVEL=INFO
# AWS profile for deploy/put_secrets when resources.profile_name is not set.
AWS_PROFILE_NAME=
